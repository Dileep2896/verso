# Foxit PDF API credentials for the Verso -> Foxit MCP gateway.
#
# Copy this file to  keys/foxit.env  (that path is gitignored) and fill in the
# values from the Foxit developer portal: Applications -> Manage -> Client ID /
# Client Secret.  Then run:  ./integrations/run_foxit_gateway.sh
#
# Do NOT commit real credentials. keys/ and .env are already in .gitignore.

FOXIT_CLIENT_ID=your_client_id_here
FOXIT_CLIENT_SECRET=your_client_secret_here

# Optional — defaults to the North America endpoint if unset:
# FOXIT_CLOUD_API_HOST=https://na1.fusion.foxit.com/pdf-services
